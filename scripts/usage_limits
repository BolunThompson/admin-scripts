#!/usr/bin/env python3
"""Print Claude and Codex usage limits in Pacific time."""

import argparse
import asyncio
import functools
import json
import os
import re
import subprocess
from datetime import datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

PACIFIC = ZoneInfo("America/Los_Angeles")


def to_pacific(dt_utc):
    return dt_utc.astimezone(PACIFIC).strftime("%a %b %d %I:%M%p %Z").replace(" 0", " ")


def parse_claude_reset(text, now_utc):
    m = re.match(r"(\w{3}) (\d{1,2}), (\d{1,2})(?::(\d{2}))?(am|pm)", text.strip())
    if not m:
        return None
    mon, day, hour, minute, ampm = m.groups()
    hour = int(hour)
    if ampm == "pm" and hour != 12:
        hour += 12
    if ampm == "am" and hour == 12:
        hour = 0
    dt = datetime.strptime(
        f"{mon} {day} {now_utc.year} {hour:02d}:{minute or '00'}", "%b %d %Y %H:%M"
    ).replace(tzinfo=timezone.utc)
    if dt < now_utc - timedelta(days=3):
        dt = dt.replace(year=now_utc.year + 1)
    return dt


async def get_claude_usage(config_dir):
    now_utc = datetime.now(timezone.utc)
    try:
        proc = await asyncio.create_subprocess_exec(
            "claude",
            "-p",
            "/usage",
            "--output-format",
            "json",
            env={
                "CLAUDE_CONFIG_DIR": str(config_dir),
                "PATH": os.environ["PATH"],
            },
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        stdout, _ = await proc.communicate()

        data = json.loads(stdout)
        text = data["result"]
    except Exception as e:
        return {"error": str(e)}

    result = {}
    session_m = re.search(
        r"Current session: (\d+)% used(?: · resets (.+?) \(UTC\))?", text
    )
    week_m = re.search(
        r"Current week \(all models\): (\d+)% used(?: · resets (.+?) \(UTC\))?", text
    )
    if session_m:
        pct = int(session_m.group(1))
        reset = (
            parse_claude_reset(session_m.group(2), now_utc)
            if session_m.group(2)
            else None
        )
        result["5h"] = (pct, reset)
    if week_m:
        pct = int(week_m.group(1))
        reset = (
            parse_claude_reset(week_m.group(2), now_utc) if week_m.group(2) else None
        )
        result["week"] = (pct, reset)
    return result


get_personal_claude_usage = functools.partial(get_claude_usage, Path.home() / ".claude")
get_work_claude_usage = functools.partial(
    get_claude_usage, Path.home() / ".claude-work"
)


async def get_codex_usage(config_dir):
    env = os.environ.copy()
    env["CODEX_HOME"] = str(config_dir)
    # The bare `codex` command may itself be a profile wrapper that resets
    # CODEX_HOME. Use the configured real binary when available.
    codex_bin = env.get("UNSNOOZE_CODEX_BIN", "codex")
    try:
        proc = await asyncio.create_subprocess_exec(
            codex_bin,
            "app-server",
            "--stdio",
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=env,
        )
    except Exception as e:
        return {"error": str(e)}
    try:

        async def send(obj):
            assert proc.stdin is not None
            proc.stdin.write(json.dumps(obj).encode() + b"\n")
            await proc.stdin.drain()

        await send(
            {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {"name": "usage-limits-script", "version": "1.0"}
                },
            }
        )
        await send({"jsonrpc": "2.0", "method": "initialized", "params": {}})
        await send(
            {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "account/rateLimits/read",
                "params": None,
            }
        )

        rate_limits = None
        assert proc.stdout is not None
        for _ in range(20):
            line = await asyncio.wait_for(proc.stdout.readline(), timeout=5)
            if not line:
                break
            try:
                obj = json.loads(line)
            except Exception:
                continue
            if obj.get("id") == 2 and "result" in obj:
                rate_limits = obj["result"]["rateLimits"]
                break
            if obj.get("id") == 2 and "error" in obj:
                return {"error": obj["error"].get("message", "unknown error")}
        if rate_limits is None:
            return {"error": "no response from codex app-server"}
    except Exception as e:
        return {"error": str(e)}
    finally:
        if proc.returncode is None:
            proc.terminate()
            await proc.wait()

    def window_label(win):
        if not win:
            return None
        mins = win.get("windowDurationMins")
        if mins and mins >= 1440:
            return f"{round(mins / 1440)}d"
        if mins:
            return f"{round(mins / 60)}h"
        return "?"

    result = {}
    for key in ("primary", "secondary"):
        win = rate_limits.get(key)
        if not win:
            continue
        label = window_label(win)
        pct = win["usedPercent"]
        resets_at = win.get("resetsAt")
        reset_dt = (
            datetime.fromtimestamp(resets_at, tz=timezone.utc) if resets_at else None
        )
        result[label] = (pct, reset_dt)
    return result


get_personal_codex_usage = functools.partial(get_codex_usage, Path.home() / ".codex")
get_personal2_codex_usage = functools.partial(get_codex_usage, Path.home() / ".codex2")
get_work_codex_usage = functools.partial(get_codex_usage, Path.home() / ".codex-work")


def fmt_reset(reset_dt):
    if reset_dt is None:
        return "n/a"
    return to_pacific(reset_dt)


def fmt_line(name, usage):
    if "error" in usage:
        return f"  {name:<12} error: {usage['error']}"
    parts = []
    for key, label in (("5h", "5h"), ("week", "week"), ("7d", "week")):
        if key in usage:
            pct, reset = usage[key]
            parts.append(f"{label:<4}: {pct:>3g}% (resets {fmt_reset(reset)})")
    return f"  {name:<12} " + "  ".join(parts)


async def main():
    usage_getters = {
        "claude": get_personal_claude_usage,
        "claude-work": get_work_claude_usage,
        "codex": get_personal_codex_usage,
        "codex2": get_personal2_codex_usage,
        "codex-work": get_work_codex_usage,
    }

    parser = argparse.ArgumentParser()
    parser.add_argument("type", default=None, choices=usage_getters, nargs="?")
    parser.add_argument("window", choices=("5h", "week", "7d"), nargs="?")
    parser.add_argument(
        "--reset",
        action="store_true",
        help="print the ISO 8601 reset time instead of the percentage",
    )
    args = parser.parse_args()

    if args.reset and args.window is None:
        parser.error(
            "--reset requires both a type and a window (e.g. claude 5h --reset)"
        )

    if args.type is None:
        now_pacific = (
            datetime.now(timezone.utc)
            .astimezone(PACIFIC)
            .strftime("%Y-%m-%d %I:%M%p %Z")
        )
        print(f"Usage limits (as of {now_pacific})\n")
        names = list(usage_getters)
        results = await asyncio.gather(*(usage_getters[name]() for name in names))
        for name, usage in zip(names, results):
            print(fmt_line(name, usage))
    else:
        usage = await usage_getters[args.type]()
        if args.window is None:
            print(fmt_line(args.type, usage))
            return
        if "error" in usage:
            parser.error(f"{args.type}: {usage['error']}")
        window = "7d" if args.window == "week" and "7d" in usage else args.window
        if window not in usage:
            parser.error(f"{args.type} has no {args.window} usage window")
        pct, reset = usage[window]
        if args.reset:
            print(reset.astimezone(PACIFIC).isoformat() if reset else "n/a")
        else:
            print(pct)


if __name__ == "__main__":
    asyncio.run(main())
